# Runtime override for foxbus's route and stops — see Foxbus.Config.
#
# Copy this file to config.exs next to the other device assets
# (mix.exs' :assets_dir, normally /media/scratch/.nest_gen2_sdk/foxbus/) and
# edit it there. No rebuild needed: restart the app (app_watchdog.sh or
# kill -TERM 1) to pick up changes.
#
# Example below points at the Holtspur stops instead of 105's Coleshill ones,
# for testing while 105 is out. Holtspur is a shared stop — 102, 103, 104 and
# 105 all call there — so `lines` lists both routes we actually want shown;
# Foxbus.Arrivals filters the scraped board down to just these, interleaved
# by time, and drops 102/103 from the display entirely. A single-element
# list (e.g. ["104"]) works the same way for one route.
# Verified clear of any current closure notice as of writing this file.

[
  lines: ["104", "105"],
  default_screen: :towards_uxbridge,
  stops: [
    {:towards_uxbridge, "040000001207", "To Uxbridge"},
    {:towards_wycombe, "040000001208", "To High Wycombe"}
  ]
]
