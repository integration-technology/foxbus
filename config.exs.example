# Pre-0.3.0 runtime override for foxbus's route and stops — see
# Foxbus.Config. Current installs should use `platform/storage.sh foxbus
# put stops|lines|default_screen ...` instead (see the README's "Changing
# the route or stops without a rebuild"); this file format only still
# matters for Foxbus.Config.migrate_from_file/0 carrying an old one's
# values into NestGen2.Storage, once, at the first boot after upgrading.
#
# If you do still need it: copy this file to config.exs next to the other
# device assets (mix.exs' :assets_dir, normally
# /media/scratch/.nest_gen2_sdk/foxbus/) and edit it there, then restart the
# app (app_watchdog.sh or kill -TERM 1) to migrate it.
#
# Placeholder stops below — see the README's "Run foxbus on your own Nest"
# for finding your own ATCO codes. A shared stop can be served by more than
# one route: list them all in `lines` and they're interleaved by time, with
# Foxbus.Arrivals filtering the scraped board down to just these. A
# single-element list (e.g. ["104"]) works the same way for one route.

[
  lines: ["104"],
  default_screen: :towards_somewhere,
  stops: [
    {:towards_somewhere, "000000000001", "To Somewhere"},
    {:towards_elsewhere, "000000000002", "To Elsewhere"}
  ]
]
